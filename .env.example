# Base de datos. En local basta un archivo SQLite; en producción, la URL libsql:// de Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Firma de las sesiones del admin y del portal. Generar con: openssl rand -base64 32
SESSION_SECRET=

# Escaneo facial (rPPG). Sin esta clave, el paso de escaneo no aparece.
VITALLENS_API_KEY=
# Proveedor del escaneo facial: "vitallens" (por omisión) o "shenai". Con "shenai" se activan los encabezados
# de aislamiento (COOP/COEP) en / y /d/<slug>, que la librería necesita.
SCAN_PROVIDER=
# Clave de administrador de Shen.AI (permiso tokens:generate). Solo en el servidor: emite un token por escaneo.
SHENAI_ADMIN_KEY=

# Correo (Resend). Sin RESEND_API_KEY los envíos quedan registrados como fallidos en email_events.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=WeNow 360 | Club WeNow
RESEND_REPLY_TO=
# Copia de avisos al asesor (si se omite, se usa el correo del distribuidor wenow).
WENOW_CORPORATE_EMAIL=
# URL pública para los enlaces de los correos (ej. https://360.wenow.global).
APP_URL=

# Narración con voz (Google Cloud Text-to-Speech). Sin clave, los botones "Escuchar" no aparecen.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=es-US-Wavenet-B

# Asistente (Gemini, capa de pago). Sin clave, el botón "Pregúntale a Winnie" no aparece.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Winnie en la portada (chat público): límite de preguntas por visitante y en total, por día.
WINNIE_VISITOR_DAILY=20
WINNIE_GLOBAL_DAILY=1500

# Voz de Winnie (Google TTS). Por defecto, voz femenina WaveNet.
ASSISTANT_TTS_VOICE=es-US-Wavenet-A
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Tienda de WeNow. Opcional: por defecto https://wenow.global. Cada distribuidor puede tener su propia URL
# de tienda (se captura en el panel de administración); esta es la de respaldo.
STORE_URL=https://wenow.global
